APP_ENV=production
APP_URL=http://localhost/LMS
APP_KEY=replace-with-a-long-random-secret
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Thư mục sao lưu phải nằm ngoài thư mục website.
LMS_BACKUP_DIR=
# false = chuyển file Drive vào Thùng rác; true = xóa vĩnh viễn.
GOOGLE_DRIVE_PERMANENT_DELETE=false
STORAGE_WARNING_PERCENT=80
STORAGE_CRITICAL_PERCENT=90

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lms_db
DB_USER=lms_user
DB_PASS=replace-with-a-strong-database-password

GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost/LMS/includes/google_auth.php
GOOGLE_DRIVE_TOKEN_PATH=D:/secure/lms/drive_token.json
GOOGLE_DRIVE_PUBLIC_FILES=false

AI_SERVICE_URL=http://127.0.0.1:8000
AI_PERSISTENT_QUEUE=true
AI_SERVICE_KEY=replace-with-another-long-random-secret
AI_ALLOWED_ROOT=D:/XAMPP/htdocs/LMS/uploads/temp_ai
AI_HOST=127.0.0.1
AI_PORT=8000
AI_MAX_CONCURRENT_GRADES=2
AI_MAX_GRADE_QUEUE_SIZE=50
AI_GRADE_QUEUE_TIMEOUT_SECONDS=300
AI_JOB_POLL_MS=1500
AI_JOB_MAX_ATTEMPTS=3
AI_DB_POOL_SIZE=5
AI_DOUBLE_CHECK=true
GEMINI_API_KEY=replace-me
# Nhiều key dự phòng, phân tách bằng dấu phẩy. Không đưa các key này lên Git.
GEMINI_API_KEYS=
# Dán tối đa 10 API key dự phòng vào các ô bên dưới. Các ô trống tự động bị bỏ qua.
GEMINI_API_KEY_BACKUP_01=
GEMINI_API_KEY_BACKUP_02=
GEMINI_API_KEY_BACKUP_03=
GEMINI_API_KEY_BACKUP_04=
GEMINI_API_KEY_BACKUP_05=
GEMINI_API_KEY_BACKUP_06=
GEMINI_API_KEY_BACKUP_07=
GEMINI_API_KEY_BACKUP_08=
GEMINI_API_KEY_BACKUP_09=
GEMINI_API_KEY_BACKUP_10=
GEMINI_MODEL=gemini-3.6-flash

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=admin.lms@gmail.com
MAIL_FROM_NAME="LMS Admin"
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_MS=2000
GEMINI_TIMEOUT_MS=180000
