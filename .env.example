APP_ENV=production
APP_URL=http://localhost/LMS
APP_KEY=replace-with-a-long-random-secret
APP_TIMEZONE=Asia/Ho_Chi_Minh
STORAGE_WARNING_PERCENT=80
STORAGE_CRITICAL_PERCENT=90

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lms_db
DB_USER=lms_user
DB_PASS=replace-with-a-strong-database-password

GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost/LMS/includes/google_auth.php
GOOGLE_DRIVE_TOKEN_PATH=D:/secure/lms/drive_token.json
GOOGLE_DRIVE_PUBLIC_FILES=false

AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_KEY=replace-with-another-long-random-secret
AI_ALLOWED_ROOT=D:/XAMPP/htdocs/LMS/uploads/temp_ai
AI_HOST=127.0.0.1
AI_PORT=8000
AI_MAX_CONCURRENT_GRADES=2
AI_MAX_GRADE_QUEUE_SIZE=50
AI_GRADE_QUEUE_TIMEOUT_SECONDS=300
AI_JOB_POLL_MS=1500
AI_JOB_MAX_ATTEMPTS=3
AI_DB_POOL_SIZE=5
AI_DOUBLE_CHECK=true
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_MS=2000
GEMINI_TIMEOUT_MS=180000
